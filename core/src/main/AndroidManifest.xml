<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- See every installed app so notification sources get real names/icons (sideload-only app). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Real SMS content (1.2.0): Android 15 redacts notification text for
         listeners, but the SMS provider is readable with user permission. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Signature-level permissions: only ecosystem-signed apps can hold them. -->
    <permission
        android:name="com.dung.notifycore.permission.IPC"
        android:label="NotifyCore IPC"
        android:protectionLevel="signature" />
    <permission
        android:name="com.dung.notifycore.permission.READ_HISTORY"
        android:label="NotifyCore history read"
        android:protectionLevel="signature" />

    <application android:name=".NotifyApp"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity android:name=".HomeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MessagesActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".AppManagerActivity" android:exported="false" />
        <activity android:name=".BackupPickerActivity" android:exported="false" />
        <activity android:name=".OnboardingActivity" android:exported="false" />

        <service
            android:name=".NotifyCoreService"
            android:exported="true"
            android:permission="com.dung.notifycore.permission.IPC">
            <intent-filter>
                <action android:name="com.dung.notifycore.contract.BIND" />
            </intent-filter>
        </service>

        <service
            android:name=".NotifyListenerService"
            android:exported="true"
            android:label="NotifyCore Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Backup export share target (1.3.0). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.dung.notifycore.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- History reads only; writes are rejected in code. -->
        <provider
            android:name=".NotifyProvider"
            android:authorities="com.dung.notifycore.provider"
            android:exported="true"
            android:readPermission="com.dung.notifycore.permission.READ_HISTORY" />
        <!-- New-SMS wake-up: triggers a provider sync. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
